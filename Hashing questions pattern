1. pattern - given an array of numbers , find all subarrays have odd numbers count as B
or give an array , find all subarrays having xor as B

public int solve(ArrayList<Integer> A, int B) {
        HashMap<Integer, Integer> h = new HashMap<>();
        
        h.put(0,1);
        int oddCount = 0;
        int subArrayCount = 0;
        for(int i=0; i<A.size(); i++) {
            if(A.get(i) %2 !=0) {
                oddCount++;
            }
            subArrayCount += h.getOrDefault((oddCount-B), 0);
            h.put(oddCount, h.getOrDefault(oddCount, 0)+1);
        }
        return subArrayCount;
    }


